#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

&mt {
    tapping-term-ms = <200>;
};

/ {
    keymap {
        compatible = "zmk,keymap";
        qwerty_layer {
            // -----------------------------------------------------------------------------------------
            // | TRANS|  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U  |  I  |  O  | BSPC| TRANS|
            // | TRANS|  A  |  S  |  D  |  F  |  G  |   |  H  |  J  |  K  |  L  |  P  | TRANS|
            // | TRANS|  Z  |  X  |  C  |  V  |  B  |   |  N  |  M  |  ,  |  .  |  /  | TRANS|
            //--------------------|     |     |     |---|     |     |     |-------------------
            // -------------------------------------------------------------------------------
            bindings = <
                &none  &kp Q        &kp W       &kp E &kp R &kp T &kp Y &kp U &kp I     &kp O        &kp BSPC       &none
                &none  &kp A        &kp S       &kp D &kp F &kp G &kp H &kp J &kp K     &kp L        &kp P          &none
                &none  &kp Z  &kp X  &kp C &kp V &kp B &kp N &kp M &kp COMMA &kp DOT &kp FSLH &none
                &mt LGUI DEL &mt LSHIFT TAB &lt 1 SPACE &lt 2 RET &mt RSHIFT ESC &mt RCTRL BSPC
                >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // | TRANS|  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | TRANS|
            // | TRANS| ALT | CTR | GUI | SHFT| CAPS|   | LFT | DWN |  UP | RGT | CAPS| TRANS|
            // | TRANS| UNDO| CUT | CPY | PST |     |   | INS | PGDN| PGUP| HOME| END | TRANS|
            //--------------------|     |     |     |---|     |     |     |-------------------
            // -------------------------------------------------------------------------------
            bindings = <
                &trans  &kp N1    &kp N2    &kp N3    &kp N4     &kp N5     &kp N6   &kp N7    &kp N8    &kp N9    &kp N0     &trans
                &trans  &sk LALT  &sk LCTRL &sk LGUI  &sk LSHIFT &caps_word &kp LEFT &kp DOWN  &kp UP    &kp RIGHT &caps_word &trans
                &trans  &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V)  &trans     &kp INS  &kp PG_DN &kp PG_UP &kp HOME  &kp END    &trans
                &trans  &trans &trans &trans &trans &trans
                >;
        };

        symbol_layer {
            // -------------------------------------------------------------------------------
            // |      |  '  |  <  |  >  |  "  |  _  |---|  &  |  ;  |  [  |  ]  |  %  |      |
            // |      |  !  |  -  |  +  |  =  |  #  |---|  |  |  :  |  (  |  )  |  ?  |      |
            // |      |  ^  |  /  |  *  |  \  |  `  |---|  @  |  $  |  {  |  }  |  ~  |      |
            //--------------------|     |     |     |---|     |     |     |-------------------
            // -------------------------------------------------------------------------------
            bindings = <
                &trans &kp SQT   &kp LT     &kp GT   &kp DQT    &kp UNDER &kp AMPS &kp SEMI  &kp LBKT &kp RBKT &kp PRCNT &trans
                &trans &kp EXCL  &kp MINUS  &kp PLUS &kp EQUAL  &kp HASH  &kp PIPE &kp COLON &kp LPAR &kp RPAR &kp QMARK &trans
                &trans &kp CARET &kp FSLH   &kp STAR &kp BSLH   &kp GRAVE &kp AT   &kp DLLR  &kp LBRC &kp RBRC &kp TILDE &trans
                &trans &trans &trans &trans &trans &trans
                >;
        };
    };
};
